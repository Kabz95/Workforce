rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(doc) {
      return signedIn() && request.auth.uid == doc.ownerId;
    }
    function sameTenant(doc) {
      return signedIn()
        && request.auth.token.tenantId == doc.tenantId;
    }
    function inSharedWith(doc) {
      return signedIn() && request.auth.uid in doc.get('sharedWith', []);
    }
    function hasRole(role) {
      return signedIn() && (
        request.auth.token.role == role
        || (request.auth.token.roles != null && role in request.auth.token.roles)
      );
    }
    function isHubCoordinator() { return hasRole('hubCoordinator') || hasRole('hubAdmin'); }
    function isHubAdmin() { return isHubCoordinator(); }
    function isPrivacyLead() { return hasRole('privacyLead'); }
    function isSteeringCircle() { return hasRole('steeringCircle') || hasRole('governance'); }
    function isCouncil() { return hasRole('council') || hasRole('governance'); }
    function isGovernance() { return isSteeringCircle() || isCouncil(); }
    function isAnalyst() { return hasRole('analyst') || hasRole('backboneAnalyst'); }

    // ---- Tenants (hubs) ----
    match /tenants/{tenantId} {
      allow get, list: if signedIn();
      allow create: if signedIn();
      allow update: if isHubAdmin() && request.auth.token.tenantId == tenantId;
      allow delete: if false;
    }

    // ---- Users ----
    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId
          || (isHubAdmin() && request.auth.token.tenantId == resource.data.tenantId));
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if false;
    }

    // ---- Worker-owned records: owner only, no bulk listing ----
    // Client updates may never change sharedWith (only the grantAccess
    // Function may, via Admin SDK), ownerId, or tenantId.
    match /workers/{workerId} {
      allow get: if isOwner(resource.data) && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data) && sameTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId;
    }
    match /firstContactForms/{formId} {
      allow get: if (isOwner(resource.data) || inSharedWith(resource.data)) && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if isOwner(resource.data) && sameTenant(resource.data)
        && request.resource.data.sharedWith == resource.data.sharedWith
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner(resource.data) && sameTenant(resource.data);
    }
    match /pathwaySteps/{stepId} {
      allow get: if (isOwner(resource.data) || inSharedWith(resource.data)) && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if isOwner(resource.data) && sameTenant(resource.data)
        && request.resource.data.sharedWith == resource.data.sharedWith
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner(resource.data) && sameTenant(resource.data);
    }
    match /certificationNavigation/{navId} {
      allow get: if (isOwner(resource.data) || inSharedWith(resource.data)) && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if isOwner(resource.data) && sameTenant(resource.data)
        && request.resource.data.sharedWith == resource.data.sharedWith
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner(resource.data) && sameTenant(resource.data);
    }
    match /evaluationSubmissions/{subId} {
      allow get: if isOwner(resource.data) && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data) && sameTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner(resource.data) && sameTenant(resource.data);
    }

    // ---- Opportunities: public within tenant; applications owner + posting employer ----
    match /opportunities/{oppId} {
      allow get, list: if signedIn() && request.auth.token.tenantId == resource.data.tenantId;
      allow create: if hasRole('employer') && request.resource.data.employerId == request.auth.uid;
      allow update, delete: if hasRole('employer') && resource.data.employerId == request.auth.uid;
    }
    match /opportunityApplications/{appId} {
      allow get: if (isOwner(resource.data)
        || (hasRole('employer') && resource.data.employerId == request.auth.uid))
        && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isOwner(resource.data)
        || (hasRole('employer') && resource.data.employerId == request.auth.uid))
        && sameTenant(resource.data)
        && request.resource.data.sharedWith == resource.data.sharedWith
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.employerId == resource.data.employerId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner(resource.data) && sameTenant(resource.data);
    }

    // ---- Mentorships: participants only ----
    match /mentorships/{mentorshipId} {
      allow get: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && sameTenant(resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.sharedWith == resource.data.sharedWith
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && sameTenant(resource.data);
    }

    // ---- Supervision: worker + supervisor via sharedWith ----
    match /supervisionSessions/{sessionId} {
      allow get: if (isOwner(resource.data) || inSharedWith(resource.data)) && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if isOwner(resource.data) && sameTenant(resource.data)
        && request.resource.data.sharedWith == resource.data.sharedWith
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner(resource.data) && sameTenant(resource.data);
    }

    // ---- Employers ----
    match /employers/{employerId} {
      allow get: if signedIn()
        && (request.auth.uid == resource.data.ownerId
          || (isHubAdmin() && sameTenant(resource.data)));
      allow list: if false;
      allow create: if hasRole('employer') && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == resource.data.ownerId;
      allow delete: if false;
    }
    match /readinessAssessments/{assessmentId} {
      allow get: if signedIn()
        && ((hasRole('employer') && resource.data.employerId == request.auth.uid)
          || isGovernance())
        && sameTenant(resource.data);
      allow list: if false;
      allow create: if hasRole('employer') && request.resource.data.employerId == request.auth.uid;
      allow update: if hasRole('employer') && resource.data.employerId == request.auth.uid;
      allow delete: if false;
    }

    // ---- Governance: decisions public within network; complaints complainant + governance ----
    match /governanceDecisions/{decisionId} {
      allow get, list: if signedIn();
      allow create, update: if isGovernance();
      allow delete: if false;
    }
    match /complaints/{complaintId} {
      allow get: if signedIn()
        && (request.auth.uid == resource.data.complainantId || isGovernance())
        && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.complainantId == request.auth.uid;
      allow update: if isGovernance() && sameTenant(resource.data);
      allow delete: if false;
    }

    // ---- Adaptation logs: hub members ----
    match /adaptationLogs/{logId} {
      allow get, list: if signedIn() && request.auth.token.tenantId == resource.data.tenantId;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == resource.data.authorId;
      allow delete: if false;
    }

    // ---- Aggregates: written by Functions only (Admin SDK), read by analysts/governance ----
    match /aggregates/{aggId} {
      allow get, list: if signedIn()
        && request.auth.token.role in ['backboneAnalyst', 'governance'];
      allow create, update, delete: if false;
    }

    // ---- Consents: granter + grantee can read; granter creates/revokes ----
    // Create: grant must start live (revokedAt null, expiry in future).
    // Update: granter may change ONLY revokedAt / revokeReason — a grant
    // cannot be re-pointed at a different person or document after creation.
    match /consents/{consentId} {
      allow get: if signedIn()
        && (request.auth.uid == resource.data.granterId
          || request.auth.uid == resource.data.granteeId)
        && sameTenant(resource.data);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.granterId == request.auth.uid
        && request.resource.data.revokedAt == null
        && request.resource.data.expiresAt > request.time;
      allow update: if signedIn()
        && request.auth.uid == resource.data.granterId
        && sameTenant(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['revokedAt', 'revokeReason']);
      allow delete: if false;
    }

    // ---- Audit log: append-only; owner reads own entries ----
    match /auditLogs/{logId} {
      allow create: if signedIn();
      allow update, delete: if false;
      allow get: if signedIn() && request.auth.uid == resource.data.subjectId;
      allow list: if false;
    }

    // ---- Deletion requests: owner creates; Functions process ----
    match /deletionRequests/{requestId} {
      allow get: if signedIn() && request.auth.uid == resource.data.ownerId;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================
    // PHASE 1: ROLE KERNEL COLLECTIONS
    // ==========================================

    // ---- Persons: one human identity ----
    match /persons/{personId} {
      allow get: if signedIn() && (
        request.auth.uid == personId ||
        (isHubCoordinator() && sameTenant(resource.data))
      );
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == personId;
      allow update: if signedIn() && request.auth.uid == personId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if false;
    }

    // ---- Role Catalog: versioned charters for canonical roles ----
    match /roleCatalog/{roleId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    // ---- Role Grants: role + scope + term + authorizer + status ----
    // Managed via server / admin SDK only; clients read their own verified grants.
    match /roleGrants/{grantId} {
      allow get, list: if signedIn() && (
        request.auth.uid == resource.data.authUid ||
        isHubCoordinator() ||
        isPrivacyLead()
      );
      allow create, update, delete: if false;
    }

    // ---- Memberships: circle relationships ----
    match /memberships/{membershipId} {
      allow get, list: if signedIn() && (
        request.auth.uid == resource.data.personId ||
        isHubCoordinator()
      );
      allow create, update, delete: if isHubCoordinator();
    }

    // ---- Assignments: worker ↔ role-holder pairing ----
    match /assignments/{assignmentId} {
      allow get: if signedIn() && (
        request.auth.uid == resource.data.workerPersonId ||
        request.auth.uid == resource.data.roleHolderPersonId ||
        isHubCoordinator()
      );
      allow list: if false;
      allow create, update, delete: if isHubCoordinator();
    }

    // ---- Conflict Declarations: recusal + mitigation notes ----
    match /conflictDeclarations/{declarationId} {
      allow get: if signedIn() && (
        request.auth.uid == resource.data.personId ||
        isGovernance()
      );
      allow list: if isGovernance();
      allow create: if signedIn() && request.auth.uid == request.resource.data.personId;
      allow update: if signedIn() && request.auth.uid == resource.data.personId;
      allow delete: if false;
    }

    // ---- Access Events: server-authored, immutable audit logs ----
    // No client creates or alters accessEvents directly.
    match /accessEvents/{eventId} {
      allow get: if signedIn() && (
        request.auth.uid == resource.data.subjectId ||
        isPrivacyLead()
      );
      allow list: if isPrivacyLead();
      allow create, update, delete: if false;
    }

    // ---- Handoffs: minimal routing metadata (Phase 2 slice) ----
    match /handoffs/{handoffId} {
      allow get: if signedIn() && (
        request.auth.uid == resource.data.workerId ||
        request.auth.uid == resource.data.recipientPersonId ||
        isHubCoordinator()
      );
      allow list: if false;
      allow create: if signedIn() && sameTenant(request.resource.data);
      allow update: if signedIn() && (
        request.auth.uid == resource.data.workerId ||
        request.auth.uid == resource.data.recipientPersonId
      );
      allow delete: if false;
    }

    // ==========================================
    // PHASE 3: EXPANSION & CIRCULAR INFRASTRUCTURE
    // ==========================================

    // ---- Help Corpus: Public and verified help articles ----
    match /helpCorpus/{articleId} {
      allow get, list: if true;
      allow create, update: if signedIn() && (isGovernance() || isPrivacyLead());
      allow delete: if false;
    }

    // ---- Circular Agreements: practice, mentorship, supervision ----
    match /agreements/{agreementId} {
      allow get: if signedIn() && (
        request.auth.uid in resource.data.participantIds ||
        isHubCoordinator() ||
        isGovernance()
      );
      allow list: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.participantIds ||
        isHubCoordinator()
      );
      allow delete: if false;
    }

    // ---- Work Queues: deterministic routing metadata ----
    match /workQueues/{queueId} {
      allow get, list: if signedIn() && (
        request.auth.uid == resource.data.assigneePersonId ||
        isHubCoordinator() ||
        isGovernance() ||
        isPrivacyLead()
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        request.auth.uid == resource.data.assigneePersonId ||
        isHubCoordinator()
      );
      allow delete: if false;
    }

    // ---- Notifications: minimal deep-link alerts (no personal data) ----
    match /notifications/{notificationId} {
      allow get, list: if signedIn() && request.auth.uid == resource.data.recipientPersonId;
      allow create: if signedIn();
      allow update: if signedIn() && request.auth.uid == resource.data.recipientPersonId;
      allow delete: if signedIn() && request.auth.uid == resource.data.recipientPersonId;
    }

    // ---- Decision Records: Circle and network governance transparency ----
    match /decisionRecords/{recordId} {
      allow get, list: if signedIn();
      allow create, update: if isGovernance();
      allow delete: if false;
    }

    // ---- Adaptations: Local hub adaptation proposals ----
    match /adaptations/{adaptationId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.authorId;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.authorId ||
        isGovernance()
      );
      allow delete: if false;
    }

    // ---- Exceptions: Time-bounded emergency boundary permissions ----
    match /exceptions/{exceptionId} {
      allow get, list: if isPrivacyLead() || isGovernance();
      allow create: if isGovernance();
      allow update, delete: if false;
    }

    // ---- Service Commitments: Circle & hub capacity commitments ----
    match /serviceCommitments/{commitmentId} {
      allow get, list: if signedIn();
      allow create, update: if isHubCoordinator() || isGovernance();
      allow delete: if false;
    }

    // ---- Publication Views: Suppressed readership statistics (k >= 5) ----
    match /publicationViews/{viewId} {
      allow get, list: if isGovernance() || isAnalyst();
      allow create, update, delete: if false;
    }

    // ---- Developer Briefs: Weekly aggregated engineering proposals ----
    match /developerBriefs/{briefId} {
      allow get, list: if isGovernance() || isPrivacyLead() || isAnalyst();
      allow create: if false;
      allow update: if isGovernance();
      allow delete: if false;
    }
  }
}

