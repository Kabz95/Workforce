rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Role Kernel — Firestore rules (Phase 1).
    //
    // These rules are the COARSE gate: claims-based role membership,
    // tenant scoping on every read and write, ownership, and
    // sharedWith immutability. The FINE gate is the policy gateway
    // in Cloud Functions, which verifies the caller's LIVE role grant
    // (server lookup) and runs the six-part authorization decision.
    // Rules cannot query roleGrants; Functions can. Both gates must
    // pass for consequential commands.
    //
    // Invariants:
    // - Every write carries tenantId == the caller's claim tenant.
    // - Clients NEVER modify sharedWith (server Functions only).
    // - Clients NEVER write accessEvents / aggregates /
    //   aggregateReleases / roleGrants / idempotencyKeys /
    //   deletionRequests (server-authored, immutable).
    // - Claims carry roles[] (canonical 13 + systemAdmin).
    // - systemAdmin is operational-only: it grants NO data access.
    // - List rules never grant a document-independent authoriser
    //   role a cross-tenant view: every authoriser disjunct in a
    //   list rule also requires storedTenantMatches.
    // ============================================================

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function claimTenant() {
      return 'tenantId' in request.auth.token ? request.auth.token.tenantId : null;
    }
    function claimRoles() {
      return 'roles' in request.auth.token ? request.auth.token.roles : null;
    }
    function hasRole(role) {
      return signedIn() && claimRoles() != null && role in claimRoles();
    }
    function hasAnyRole(roles) {
      return signedIn() && claimRoles() != null && claimRoles().hasAny(roles);
    }
    // Tenant of the incoming document must equal the caller's claim tenant.
    function incomingTenantMatches(doc) {
      return signedIn() && claimTenant() != null && doc.tenantId == claimTenant();
    }
    // Tenant of the stored document must equal the caller's claim tenant.
    function storedTenantMatches(doc) {
      return signedIn() && claimTenant() != null && doc.tenantId == claimTenant();
    }
    function isOwner(doc) {
      return signedIn() && uid() == doc.ownerId;
    }
    function isSharedWith(doc) {
      return signedIn() && uid() in doc.get('sharedWith', []);
    }
    // Owner / tenant / sharedWith are immutable on client updates.
    function immutableCoreUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', []);
    }
    // Only the listed keys may change on this update.
    function onlyKeysChange(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isHubCoordinator() { return hasRole('hubCoordinator'); }
    function isPrivacyLead() { return hasRole('privacyLead'); }
    function canAuthorise() {
      return hasAnyRole(['hubCoordinator', 'privacyLead', 'council', 'backboneLead']);
    }

    // ---- Tenants (hubs) ----
    // Tenant docs carry no tenantId field — the document ID IS the tenant.
    // Creating a tenant is governance (council / backboneLead only):
    // a tenant doc itself grants no data access — every other rule keys
    // on the caller's CLAIM tenant, not on this collection — but tenant
    // creation is not something any signed-in user may do.
    match /tenants/{tenantId} {
      allow get, list: if signedIn();
      allow create: if hasAnyRole(['council', 'backboneLead']);
      allow update: if isHubCoordinator() && claimTenant() == tenantId;
      allow delete: if false;
    }

    // ---- Users (profile docs) ----
    // Production onboarding: accounts come from invitations. Clients
    // NEVER create users docs — there is no claim-less self-signup
    // bootstrap and no demo tenant. The server (ensureMyPerson)
    // creates persons docs; users/ is retained for owner read/update
    // of pre-existing docs only. Clients may change displayName/email
    // only — never roles/tenantId.
    match /users/{userId} {
      allow get: if signedIn()
        && (uid() == userId
          || (isHubCoordinator() && storedTenantMatches(resource.data)));
      allow list: if false;
      allow create: if false;
      allow update: if signedIn() && uid() == userId
        && storedTenantMatches(resource.data)
        && immutableCoreUnchanged()
        && request.resource.data.roles == resource.data.roles
        && onlyKeysChange(['displayName', 'email']);
      allow delete: if false;
    }

    // ---- Persons (one per account) ----
    // Server-created only (ensureMyPerson): client creation is denied,
    // including for the owner. Owner read/update of their own doc.
    match /persons/{personId} {
      allow get: if signedIn()
        && (uid() == personId
          || (canAuthorise() && storedTenantMatches(resource.data)));
      allow list: if false;
      allow create: if false;
      allow update: if signedIn() && uid() == personId
        && storedTenantMatches(resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && onlyKeysChange(['displayName', 'email']);
      allow delete: if false;
    }

    // ---- Role grants (server-written; clients read own + authorisers) ----
    match /roleGrants/{grantId} {
      allow get: if signedIn()
        && (uid() == resource.data.granteeId
          || (canAuthorise() && storedTenantMatches(resource.data)));
      allow list: if signedIn()
        && (uid() == resource.data.granteeId
          || (canAuthorise() && storedTenantMatches(resource.data)));
      allow create, update, delete: if false;
    }

    // ---- Memberships (server-written) ----
    match /memberships/{membershipId} {
      allow get: if signedIn()
        && (uid() == resource.data.personId
          || (canAuthorise() && storedTenantMatches(resource.data)));
      allow list: if signedIn()
        && (uid() == resource.data.personId
          || (canAuthorise() && storedTenantMatches(resource.data)));
      allow create, update, delete: if false;
    }

    // ---- Assignments (server-written) ----
    match /assignments/{assignmentId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (uid() == resource.data.workerId
          || uid() == resource.data.holderId
          || isHubCoordinator());
      allow list: if signedIn()
        && (uid() == resource.data.workerId
          || uid() == resource.data.holderId
          || (isHubCoordinator() && storedTenantMatches(resource.data)));
      allow create, update, delete: if false;
    }

    // ---- Conflict declarations ----
    match /conflictDeclarations/{conflictId} {
      allow get: if signedIn()
        && (uid() == resource.data.declarerId
          || (canAuthorise() && storedTenantMatches(resource.data)));
      allow list: if signedIn()
        && (uid() == resource.data.declarerId
          || (canAuthorise() && storedTenantMatches(resource.data)));
      allow create: if signedIn()
        && uid() == request.resource.data.declarerId
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.status == 'open';
      allow update: if signedIn() && canAuthorise()
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && onlyKeysChange(['status']);
      allow delete: if false;
    }

    // ---- Handoffs ----
    // Sender offers → recipient responds. The responder is the
    // RECIPIENT (matches the Functions gateway, which verifies the
    // recipient's live grant for the recipient role). The worker is
    // the subject, not the responder.
    match /handoffs/{handoffId} {
      allow get: if signedIn()
        && (uid() == resource.data.workerId
          || uid() == resource.data.senderId
          || uid() == resource.data.recipientId);
      allow list: if signedIn() && storedTenantMatches(resource.data)
        && (uid() == resource.data.workerId
          || uid() == resource.data.senderId
          || uid() == resource.data.recipientId);
      allow create: if signedIn()
        && uid() == request.resource.data.senderId
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.status == 'offered'
        && request.resource.data.senderRole in claimRoles()
        && request.resource.data.senderId != request.resource.data.workerId
        && request.resource.data.recipientId != request.resource.data.workerId
        && request.resource.data.senderId != request.resource.data.recipientId;
      allow update: if signedIn()
        && uid() == resource.data.recipientId
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && onlyKeysChange(['status'])
        && resource.data.status == 'offered'
        && request.resource.data.status in ['accepted', 'declined', 'closed'];
      allow delete: if false;
    }

    // ---- Worker records (owner only — no hub view of worker records) ----
    match /workers/{workerId} {
      allow get, list: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
      allow create: if signedIn() && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data)
        && immutableCoreUnchanged();
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- First-contact forms (owner or consented grantee) ----
    match /firstContactForms/{formId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow list: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow create: if signedIn() && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data)
        && immutableCoreUnchanged();
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- Pathway steps ----
    match /pathwaySteps/{stepId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow list: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow create: if signedIn() && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data)
        && immutableCoreUnchanged();
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- Certification navigation ----
    match /certificationNavigation/{navId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow list: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow create: if signedIn() && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data)
        && immutableCoreUnchanged();
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- Supervision sessions (Phase 2) ----
    // Model (confirmed against types.ts + grantAccess + deletion):
    // - ownerId = the worker who owns the session record.
    // - supervisorId = the linked supervisor (a LINK, not an access
    //   grant — it confers no read by itself).
    // - sharedWith = consent-based readers. The supervisor reads ONLY
    //   through a live worker consent (grantAccess), never via
    //   supervisorId. This block mirrors the other shareable
    //   collections exactly: owner OR sharedWith, tenant-scoped.
    match /supervisionSessions/{sessionId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow list: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || isSharedWith(resource.data));
      allow create: if signedIn() && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data)
        && immutableCoreUnchanged();
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- Mentorships (Phase 2 completion) ----
    // Model:
    // - A mentorship is a PAIR: exactly two participants. The caller
    //   must be one of them to create it.
    // - participantIds + tenantId are immutable on client update;
    //   participants may edit notes only.
    // - Either participant may end (delete) the mentorship.
    // - sharedWith = consent-based readers (mentorships is an
    //   ALLOWED_SHARE_TARGET; grantAccess verifies participation).
    //   Readers are participants OR consented readers, tenant-scoped.
    match /mentorships/{mentorshipId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (uid() in resource.data.participantIds || isSharedWith(resource.data));
      allow list: if signedIn() && storedTenantMatches(resource.data)
        && (uid() in resource.data.participantIds || isSharedWith(resource.data));
      allow create: if signedIn()
        && uid() in request.resource.data.participantIds
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.resource.data.get('sharedWith', []) == []
        && request.resource.data.notes is string;
      allow update: if signedIn() && uid() in resource.data.participantIds
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.participantIds == resource.data.participantIds
        && onlyKeysChange(['notes']);
      allow delete: if signedIn() && uid() in resource.data.participantIds
        && storedTenantMatches(resource.data);
    }

    // ---- Consents (consent grants) ----
    match /consents/{consentId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (uid() == resource.data.granterId || uid() == resource.data.granteeId);
      allow list: if signedIn()
        && (uid() == resource.data.granterId || uid() == resource.data.granteeId);
      allow create: if signedIn()
        && uid() == request.resource.data.granterId
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.resourceType in [
          'firstContactForms', 'pathwaySteps', 'certificationNavigation', 'supervisionSessions', 'mentorships']
        && request.resource.data.scope == 'read:' + request.resource.data.resourceType
        && request.resource.data.granteeId is string
        && request.resource.data.resourceId is string
        && request.resource.data.purpose is string
        && request.resource.data.revokedAt == null
        && request.resource.data.expiresAt > request.time;
      // Only the granter may revoke, and only revokedAt may change.
      // Revocation is one-way: null -> timestamp only (no un-revoke).
      allow update: if signedIn()
        && uid() == resource.data.granterId
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && onlyKeysChange(['revokedAt'])
        && resource.data.revokedAt == null
        && request.resource.data.revokedAt is timestamp;
      allow delete: if false;
    }

    // ---- Opportunities (tenant-visible) ----
    match /opportunities/{opportunityId} {
      allow get, list: if signedIn() && storedTenantMatches(resource.data);
      allow create: if signedIn()
        && hasAnyRole(['employer', 'hubCoordinator'])
        && incomingTenantMatches(request.resource.data)
        && uid() == request.resource.data.employerId;
      allow update: if signedIn()
        && (uid() == resource.data.employerId || isHubCoordinator())
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.employerId == resource.data.employerId;
      allow delete: if signedIn()
        && (uid() == resource.data.employerId || isHubCoordinator())
        && storedTenantMatches(resource.data);
    }

    // ---- Opportunity applications ----
    match /opportunityApplications/{applicationId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || uid() == resource.data.employerId);
      allow list: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || uid() == resource.data.employerId);
      allow create: if signedIn() && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.get('sharedWith', []) == [];
      allow update: if signedIn() && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && (
          // Applicant may withdraw only.
          (isOwner(resource.data) && onlyKeysChange(['status'])
            && request.resource.data.status == 'withdrawn')
          // Employer may move the decision forward.
          || (uid() == resource.data.employerId && onlyKeysChange(['status'])
            && request.resource.data.status in ['reviewed', 'accepted', 'declined'])
        );
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- Employers ----
    match /employers/{employerId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (isOwner(resource.data) || canAuthorise());
      allow list: if signedIn()
        && (isOwner(resource.data) || (canAuthorise() && storedTenantMatches(resource.data)));
      allow create: if signedIn() && hasRole('employer')
        && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data);
      allow update: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data)
        && immutableCoreUnchanged();
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- Readiness assessments (immutable once submitted) ----
    match /readinessAssessments/{assessmentId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (uid() == resource.data.employerId || canAuthorise());
      allow list: if signedIn()
        && (uid() == resource.data.employerId || (canAuthorise() && storedTenantMatches(resource.data)));
      allow create: if signedIn()
        && uid() == request.resource.data.employerId
        && incomingTenantMatches(request.resource.data);
      allow update, delete: if false;
    }

    // ---- Governance decisions (published; governance roles write) ----
    match /governanceDecisions/{decisionId} {
      allow get, list: if signedIn() && storedTenantMatches(resource.data);
      allow create: if signedIn()
        && hasAnyRole(['steeringCircle', 'council', 'hubCoordinator'])
        && incomingTenantMatches(request.resource.data);
      allow update: if signedIn()
        && hasAnyRole(['steeringCircle', 'council', 'hubCoordinator'])
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data);
      allow delete: if signedIn()
        && hasAnyRole(['steeringCircle', 'council', 'hubCoordinator'])
        && storedTenantMatches(resource.data);
    }

    // ---- Complaints ----
    match /complaints/{complaintId} {
      allow get: if signedIn() && storedTenantMatches(resource.data)
        && (uid() == resource.data.complainantId || canAuthorise());
      allow list: if signedIn()
        && (uid() == resource.data.complainantId || (canAuthorise() && storedTenantMatches(resource.data)));
      allow create: if signedIn()
        && uid() == request.resource.data.complainantId
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.status == 'open';
      allow update: if signedIn() && canAuthorise()
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && onlyKeysChange(['status']);
      allow delete: if false;
    }

    // ---- Adaptation logs ----
    match /adaptationLogs/{logId} {
      allow get, list: if signedIn() && storedTenantMatches(resource.data);
      allow create: if signedIn()
        && hasAnyRole(['hubCoordinator', 'backboneLead', 'facilitator', 'analyst'])
        && uid() == request.resource.data.authorId
        && incomingTenantMatches(request.resource.data);
      allow update: if signedIn()
        && uid() == resource.data.authorId
        && storedTenantMatches(resource.data)
        && incomingTenantMatches(request.resource.data)
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if signedIn()
        && uid() == resource.data.authorId
        && storedTenantMatches(resource.data);
    }

    // ---- Evaluation submissions (owner only — raw data never flows up) ----
    match /evaluationSubmissions/{submissionId} {
      allow get, list: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
      allow create: if signedIn() && isOwner(request.resource.data)
        && incomingTenantMatches(request.resource.data);
      allow update: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data)
        && immutableCoreUnchanged();
      allow delete: if signedIn() && isOwner(resource.data) && storedTenantMatches(resource.data);
    }

    // ---- Aggregates (server-written; governance + analyst read) ----
    // Published by design: national roles (analyst, council,
    // backboneLead) read cross-hub; hub roles stay tenant-scoped.
    // Cells < 5 are suppressed server-side before any aggregate is
    // written, so cross-hub reads cannot re-identify individuals.
    match /aggregates/{aggregateId} {
      allow get, list: if signedIn()
        && (hasAnyRole(['analyst', 'council', 'backboneLead'])
          || (storedTenantMatches(resource.data)
            && hasAnyRole(['steeringCircle', 'hubCoordinator', 'privacyLead'])));
      allow create, update, delete: if false;
    }

    // ---- Aggregate releases (server-written) ----
    match /aggregateReleases/{releaseId} {
      allow get, list: if signedIn()
        && (hasAnyRole(['analyst', 'council', 'backboneLead'])
          || (storedTenantMatches(resource.data)
            && hasAnyRole(['steeringCircle', 'hubCoordinator', 'privacyLead'])));
      allow create, update, delete: if false;
    }

    // ---- Access events (server-authored; subject + privacy lead read) ----
    match /accessEvents/{eventId} {
      allow get: if signedIn()
        && (uid() == resource.data.subjectId
          || (isPrivacyLead() && storedTenantMatches(resource.data)));
      allow list: if signedIn()
        && (uid() == resource.data.subjectId || (isPrivacyLead() && storedTenantMatches(resource.data)));
      allow create, update, delete: if false;
    }

    // ---- Idempotency keys (server only) ----
    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }

    // ---- Deletion requests (server-written; owner reads) ----
    match /deletionRequests/{requestId} {
      allow get: if signedIn() && uid() == resource.data.ownerId;
      allow list: if signedIn() && uid() == resource.data.ownerId;
      allow create, update, delete: if false;
    }

    // ---- Developer suggestions (Phase 3, P3.2 — server-written draft
    // briefs from aggregate support signals; counts only, no raw text,
    // no identities). Network roles read cross-tenant; hub roles read
    // their own tenant's briefs. Same shape as aggregates. ----
    match /developerSuggestions/{briefId} {
      allow get, list: if signedIn()
        && (hasAnyRole(['analyst', 'council', 'backboneLead'])
          || (storedTenantMatches(resource.data)
            && hasAnyRole(['steeringCircle', 'hubCoordinator', 'privacyLead'])));
      allow create, update, delete: if false;
    }

    // ---- Deny everything else ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
